PORT=3000
LIVERELOAD=true

# Optional: chrome for installed Google Chrome; omit to use Playwright Chromium.
# RENDER_BROWSER_CHANNEL=chrome

# PageSpeed Insights: optional backend-only key. Empty disables provider requests.
PAGESPEED_API_KEY=

# Database (when using mysql2)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mydb

# JWT (when using jsonwebtoken)
JWT_SECRET=your-secret-key

# Upload (when using multer) – optional

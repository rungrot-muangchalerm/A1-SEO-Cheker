PORT=3000
LIVERELOAD=true

# Optional: chrome for installed Google Chrome; omit to use Playwright Chromium.
# RENDER_BROWSER_CHANNEL=chrome

# PageSpeed Insights: optional backend-only key. Empty disables provider requests.
PAGESPEED_API_KEY=

# Site crawl safety budgets. Restart the server after changing these settings.
CRAWL_MAX_PAGES=5000
CRAWL_TIMEOUT_MS=3600000
CRAWL_MAX_REQUESTS=40000
CRAWL_MAX_HTML_MB=128
DISCOVERY_MAX_URLS=10000
DISCOVERY_MAX_SITEMAPS=100
DISCOVERY_TIMEOUT_MS=300000

# Database (when using mysql2)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mydb

# JWT (when using jsonwebtoken)
JWT_SECRET=your-secret-key

# Upload (when using multer) – optional

<header class="bg-success-subtle border-bottom border-success-subtle py-3">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="h4 mb-0 text-success-emphasis d-flex align-items-center gap-2">
      <i data-lucide="scan-search" width="24" height="24" aria-hidden="true"></i>
      SEO Checker
    </h1>
  </div>
</header>

<main class="container py-4">
  <form id="scan-form" class="row g-2 align-items-end mb-3" autocomplete="off">
    <div class="col-12 col-md-9 col-lg-10">
      <label for="website-url" class="form-label">URL &#3648;&#3623;&#3655;&#3610;&#3652;&#3595;&#3605;&#3660;</label>
      <input type="url" class="form-control bg-success-subtle border-success text-success-emphasis" id="website-url" name="url" placeholder="https://example.com" autocomplete="off" inputmode="url" spellcheck="false" required>
    </div>
    <div class="col-12 col-md-3 col-lg-2 d-grid">
      <button type="submit" class="btn btn-success d-flex justify-content-center align-items-center gap-2" id="scan-button">
          <i data-lucide="scan-search" width="18" height="18" aria-hidden="true"></i>
          <span class="spinner-border spinner-border-sm d-none" id="scan-spinner" aria-hidden="true"></span>
        <span id="scan-button-label">&#3605;&#3619;&#3623;&#3592;&#3648;&#3623;&#3655;&#3610;&#3652;&#3595;&#3605;&#3660;</span>
      </button>
    </div>
  </form>
    <p class="small text-primary-emphasis text-break mb-4" id="scan-status" role="status" aria-live="polite"></p>

  <div id="report" aria-busy="false" hidden>
    <section class="mb-4" aria-labelledby="overview-heading">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <h2 class="h5 mb-0" id="overview-heading">&#3616;&#3634;&#3614;&#3619;&#3623;&#3617;&#3585;&#3634;&#3619;&#3605;&#3619;&#3623;&#3592;</h2>
        <span class="small text-success-emphasis text-break" id="report-host"></span>
      </div>
      <div class="row row-cols-2 row-cols-lg-4 g-3 border-bottom border-info-subtle pb-4">
        <div class="col">
          <div class="border-start border-primary border-3 ps-3">
            <p class="h2 fw-semibold mb-1" id="summary-pages"></p>
            <p class="small mb-0">&#3627;&#3609;&#3657;&#3634;&#3607;&#3637;&#3656;&#3605;&#3619;&#3623;&#3592;</p>
          </div>
        </div>
        <div class="col">
          <div class="border-start border-danger border-3 ps-3">
            <p class="h2 fw-semibold text-danger-emphasis mb-1" id="summary-critical"></p>
            <p class="small mb-0">&#3611;&#3633;&#3597;&#3627;&#3634;&#3607;&#3637;&#3656;&#3605;&#3657;&#3629;&#3591;&#3649;&#3585;&#3657;&#3585;&#3656;&#3629;&#3609;</p>
          </div>
        </div>
        <div class="col">
          <div class="border-start border-warning border-3 ps-3">
            <p class="h2 fw-semibold text-warning-emphasis mb-1" id="summary-warning"></p>
            <p class="small mb-0">&#3611;&#3633;&#3597;&#3627;&#3634;&#3607;&#3637;&#3656;&#3588;&#3623;&#3619;&#3611;&#3619;&#3633;&#3610;</p>
          </div>
        </div>
        <div class="col">
          <div class="border-start border-info border-3 ps-3">
            <p class="h2 fw-semibold mb-1" id="summary-review"></p>
            <p class="small mb-0">&#3619;&#3634;&#3618;&#3585;&#3634;&#3619;&#3607;&#3637;&#3656;&#3605;&#3657;&#3629;&#3591;&#3618;&#3639;&#3609;&#3618;&#3633;&#3609;</p>
          </div>
        </div>
      </div>
        <p class="small mb-0 mt-3" id="affected-summary"></p>
        <p class="small text-break mb-1 mt-2" id="report-scope"></p>
        <p class="small mb-0" id="report-time"></p>
        <p class="small mb-0 mt-2" id="report-result" role="status"></p>
        <details class="small mt-3" id="not-checked-section" hidden>
          <summary>&#3618;&#3633;&#3591;&#3652;&#3604;&#3657;&#3605;&#3619;&#3623;&#3592; <span id="not-checked-count"></span></summary>
          <ul class="mt-2 mb-0 ps-3" id="not-checked-list"></ul>
        </details>
    </section>

    <ul class="nav nav-tabs nav-fill border-info-subtle mb-4" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active bg-success-subtle text-primary-emphasis small px-2" id="issues-tab" data-bs-toggle="tab" data-bs-target="#issues-pane" type="button" role="tab" aria-controls="issues-pane" aria-selected="true">&#3611;&#3633;&#3597;&#3627;&#3634;</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link bg-transparent text-primary-emphasis small px-2" id="pages-tab" data-bs-toggle="tab" data-bs-target="#pages-pane" type="button" role="tab" aria-controls="pages-pane" aria-selected="false">&#3627;&#3609;&#3657;&#3634;&#3607;&#3637;&#3656;&#3605;&#3619;&#3623;&#3592;</button>
      </li>
    </ul>

    <div class="tab-content">
      <section class="tab-pane show active" id="issues-pane" role="tabpanel" aria-labelledby="issues-tab" tabindex="0">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
          <h2 class="h5 mb-0">&#3611;&#3633;&#3597;&#3627;&#3634;&#3607;&#3637;&#3656;&#3614;&#3610; <span class="small fw-normal" id="issue-count"></span></h2>
          <button class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-2" type="button" id="export-button" disabled>
            <i data-lucide="file-down" width="16" height="16" aria-hidden="true"></i>
            &#3604;&#3634;&#3623;&#3609;&#3660;&#3650;&#3627;&#3621;&#3604; CSV
          </button>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-6 col-md-3">
            <label for="severity-filter" class="form-label small mb-1">&#3588;&#3623;&#3634;&#3617;&#3626;&#3635;&#3588;&#3633;&#3597;</label>
            <select class="form-select form-select-sm bg-info-subtle border-info-subtle" id="severity-filter">
              <option value="all">&#3607;&#3633;&#3657;&#3591;&#3627;&#3617;&#3604;</option>
              <option value="critical">&#3605;&#3657;&#3629;&#3591;&#3649;&#3585;&#3657;&#3585;&#3656;&#3629;&#3609;</option>
              <option value="warning">&#3588;&#3623;&#3619;&#3611;&#3619;&#3633;&#3610;</option>
              <option value="review">&#3605;&#3657;&#3629;&#3591;&#3618;&#3639;&#3609;&#3618;&#3633;&#3609;</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label for="category-filter" class="form-label small mb-1">&#3627;&#3617;&#3623;&#3604;</label>
            <select class="form-select form-select-sm bg-info-subtle border-info-subtle" id="category-filter">
              <option value="all">&#3607;&#3640;&#3585;&#3627;&#3617;&#3623;&#3604;</option>
              <option value="index">&#3585;&#3634;&#3619;&#3648;&#3586;&#3657;&#3634; index</option>
              <option value="onpage">&#3586;&#3657;&#3629;&#3617;&#3641;&#3621;&#3610;&#3609;&#3627;&#3609;&#3657;&#3634;</option>
              <option value="links">&#3621;&#3636;&#3591;&#3585;&#3660;&#3616;&#3634;&#3618;&#3651;&#3609;</option>
              <option value="sitemap">Sitemap</option>
              <option value="images">&#3619;&#3641;&#3611;&#3616;&#3634;&#3614;</option>
              <option value="render">JavaScript</option>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label for="issue-search" class="form-label small mb-1">&#3588;&#3657;&#3609;&#3627;&#3634;&#3611;&#3633;&#3597;&#3627;&#3634;&#3627;&#3619;&#3639;&#3629; URL</label>
            <input type="search" class="form-control form-control-sm bg-info-subtle border-info-subtle" id="issue-search" placeholder="&#3648;&#3594;&#3656;&#3609; title &#3627;&#3619;&#3639;&#3629; /services">
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-info table-hover align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th scope="col" class="small text-nowrap">&#3619;&#3632;&#3604;&#3633;&#3610;</th>
                <th scope="col" class="small">&#3611;&#3633;&#3597;&#3627;&#3634;</th>
                <th scope="col" class="small text-nowrap d-none d-sm-table-cell">&#3627;&#3609;&#3657;&#3634;&#3607;&#3637;&#3656;&#3614;&#3610;</th>
                <th scope="col"><span class="visually-hidden">&#3619;&#3634;&#3618;&#3621;&#3632;&#3648;&#3629;&#3637;&#3618;&#3604;</span></th>
              </tr>
            </thead>
            <tbody id="issue-rows"></tbody>
          </table>
        </div>
        <div class="text-center py-5 d-none" id="issue-empty">
          <i data-lucide="search-x" width="28" height="28" aria-hidden="true"></i>
            <p class="mt-3 mb-3" id="issue-empty-message">&#3652;&#3617;&#3656;&#3614;&#3610;&#3619;&#3634;&#3618;&#3585;&#3634;&#3619;&#3605;&#3634;&#3617;&#3605;&#3633;&#3623;&#3585;&#3619;&#3629;&#3591;&#3609;&#3637;&#3657;</p>
          <button class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-2" type="button" id="reset-filters">
            <i data-lucide="rotate-ccw" width="16" height="16" aria-hidden="true"></i>
            &#3621;&#3657;&#3634;&#3591;&#3605;&#3633;&#3623;&#3585;&#3619;&#3629;&#3591;
          </button>
        </div>
        <p class="small mt-3 mb-0" id="issue-result-status" role="status" aria-live="polite"></p>
      </section>

      <section class="tab-pane" id="pages-pane" role="tabpanel" aria-labelledby="pages-tab" tabindex="0">
        <h2 class="h5 mb-3">&#3627;&#3609;&#3657;&#3634;&#3607;&#3637;&#3656;&#3605;&#3619;&#3623;&#3592;</h2>
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-4">
            <label for="page-filter" class="form-label small mb-1">&#3612;&#3621;&#3605;&#3619;&#3623;&#3592;</label>
            <select class="form-select form-select-sm bg-info-subtle border-info-subtle" id="page-filter">
              <option value="all">&#3607;&#3640;&#3585;&#3627;&#3609;&#3657;&#3634;</option>
              <option value="critical">&#3605;&#3657;&#3629;&#3591;&#3649;&#3585;&#3657;&#3585;&#3656;&#3629;&#3609;</option>
              <option value="warning">&#3588;&#3623;&#3619;&#3611;&#3619;&#3633;&#3610;</option>
              <option value="review">&#3605;&#3657;&#3629;&#3591;&#3618;&#3639;&#3609;&#3618;&#3633;&#3609;</option>
              <option value="pass">&#3652;&#3617;&#3656;&#3614;&#3610;&#3611;&#3633;&#3597;&#3627;&#3634;&#3605;&#3634;&#3617;&#3619;&#3634;&#3618;&#3585;&#3634;&#3619;&#3605;&#3619;&#3623;&#3592;</option>
              <option value="not-checked">&#3618;&#3633;&#3591;&#3605;&#3619;&#3623;&#3592;&#3652;&#3617;&#3656;&#3652;&#3604;&#3657;</option>
            </select>
          </div>
          <div class="col-12 col-md-8">
            <label for="page-search" class="form-label small mb-1">&#3588;&#3657;&#3609;&#3627;&#3634; URL &#3627;&#3619;&#3639;&#3629; title</label>
            <input type="search" class="form-control form-control-sm bg-info-subtle border-info-subtle" id="page-search" placeholder="/blog">
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-info table-hover align-middle mb-0">
            <thead class="table-success">
              <tr>
                <th scope="col" class="small">URL / Title</th>
                <th scope="col" class="small text-nowrap">HTTP</th>
                <th scope="col" class="small text-nowrap">&#3612;&#3621;&#3605;&#3619;&#3623;&#3592;</th>
                <th scope="col"><span class="visually-hidden">&#3619;&#3634;&#3618;&#3621;&#3632;&#3648;&#3629;&#3637;&#3618;&#3604;&#3627;&#3609;&#3657;&#3634;</span></th>
              </tr>
            </thead>
            <tbody id="page-rows"></tbody>
          </table>
        </div>
        <p class="text-center py-4 d-none" id="page-empty">&#3652;&#3617;&#3656;&#3614;&#3610;&#3627;&#3609;&#3657;&#3634;&#3607;&#3637;&#3656;&#3605;&#3619;&#3591;&#3585;&#3633;&#3610;&#3605;&#3633;&#3623;&#3585;&#3619;&#3629;&#3591;&#3609;&#3637;&#3657;</p>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-3">
          <p class="small mb-0" id="page-result-status" role="status" aria-live="polite"></p>
          <div class="d-flex align-items-center gap-3">
            <button class="btn btn-sm btn-outline-success" type="button" id="pages-prev" aria-label="&#3627;&#3609;&#3657;&#3634;&#3585;&#3656;&#3629;&#3609;&#3627;&#3609;&#3657;&#3634;" title="&#3627;&#3609;&#3657;&#3634;&#3585;&#3656;&#3629;&#3609;&#3627;&#3609;&#3657;&#3634;" data-bs-toggle="tooltip">
              <i data-lucide="chevron-left" width="18" height="18" aria-hidden="true"></i>
            </button>
            <span class="small" id="pages-pager"></span>
            <button class="btn btn-sm btn-outline-success" type="button" id="pages-next" aria-label="&#3627;&#3609;&#3657;&#3634;&#3606;&#3633;&#3604;&#3652;&#3611;" title="&#3627;&#3609;&#3657;&#3634;&#3606;&#3633;&#3604;&#3652;&#3611;" data-bs-toggle="tooltip">
              <i data-lucide="chevron-right" width="18" height="18" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </section>

    </div>

    <section class="mt-4 border-top border-info-subtle pt-3" aria-labelledby="audit-heading">
      <h2 class="h6 mb-0" id="audit-heading">
        <button class="btn btn-link text-success-emphasis text-decoration-none px-0 d-inline-flex align-items-center gap-2 text-start" type="button" data-bs-toggle="collapse" data-bs-target="#lighthouse-scores" aria-expanded="false" aria-controls="lighthouse-scores">
          <i data-lucide="gauge" width="18" height="18" aria-hidden="true"></i>
          &#3588;&#3632;&#3649;&#3609;&#3609; Lighthouse &#3586;&#3629;&#3591;&#3627;&#3609;&#3657;&#3634;&#3627;&#3621;&#3633;&#3585;
          <i data-lucide="chevron-down" width="16" height="16" aria-hidden="true"></i>
        </button>
      </h2>
      <div class="collapse pt-3" id="lighthouse-scores">
        <p class="small mb-0" id="lighthouse-status">&#3618;&#3633;&#3591;&#3652;&#3617;&#3656;&#3652;&#3604;&#3657;&#3605;&#3619;&#3623;&#3592;</p>
        <div id="lighthouse-categories"></div>
      </div>
    </section>
  </div>
  <p class="small mt-3 mb-0 text-success-emphasis" id="app-message" role="status" aria-live="polite"></p>
</main>

<aside class="offcanvas offcanvas-end bg-info-subtle" tabindex="-1" id="issue-drawer" aria-labelledby="detail-title">
  <div class="offcanvas-header border-bottom border-info-subtle">
    <h2 class="offcanvas-title h5 text-primary-emphasis" id="detail-title">&#3619;&#3634;&#3618;&#3621;&#3632;&#3648;&#3629;&#3637;&#3618;&#3604;</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="&#3611;&#3636;&#3604;&#3619;&#3634;&#3618;&#3621;&#3632;&#3648;&#3629;&#3637;&#3618;&#3604;"></button>
  </div>
  <div class="offcanvas-body text-primary-emphasis" id="detail-content"></div>
</aside>

<script src="https://cdn.jsdelivr.net/npm/lucide@1.51.0/dist/umd/lucide.min.js" defer></script>
<script src="/assets/js/app.js" defer></script>
